# ---- API (backend port 4000) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
# SSR ke liye server-side fetch (usually same as above locally)
API_INTERNAL_URL=http://localhost:4000

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Analytics / Marketing (ID daalte hi live, khali = script load nahi hoti) ----
# GA4 — live blog.chaupal.com wali property (Site Kit gtag GT-5RFWCKVN isi G- ID te route karda hai;
# dono nahi daalne, warna double-counting)
NEXT_PUBLIC_GA4_ID=G-S59Q78H762
# GTM container (GTM-XXXXXXX) — purane head vich nahi mila; banao to yahan daalo
NEXT_PUBLIC_GTM_ID=
# Meta Pixel — purane head vich nahi mila (shayad footer snippet vich hai); ID mile to yahan
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Google Search Console verification ----
# Dono existing codes (comma-separated, dono meta tags render honge — koi access nahi tutega)
NEXT_PUBLIC_GSC_VERIFICATION=l-y0gLUqKkSQzS-4uD-jzzz1fxm5dmhBEHfdW16sXz0,QdVAfJ-HctHRmw_Nt26YnjFug1j1zfhD0gkeZNvYc7Q
