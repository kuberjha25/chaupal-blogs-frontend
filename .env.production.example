# SSR server-to-server fetch — same server te dono chal rahe ne ta internal:
API_INTERNAL_URL=http://localhost:4000                  # ★ (alag host ho ta public API URL)

NEXT_PUBLIC_SITE_URL=https://blog.chaupal.com

